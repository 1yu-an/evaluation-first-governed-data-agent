MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=data_agent
DATA_AGENT_EXECUTOR=mysql

# Optional external Domain Profile; omit for profiles/demo.json.
# DATA_AGENT_PROFILE=profiles/expenses.json
# Optional SQLite path; explicit --db-path takes precedence.
# DATA_AGENT_DB_PATH=expenses.db

# Used only by scripts/setup_mysql.py and Docker initialization.
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=replace-with-admin-password

# Used by DataAgent's MySQLExecutor at runtime.
MYSQL_AGENT_USER=data_agent_ro
MYSQL_AGENT_PASSWORD=replace-with-read-only-password
MYSQL_AGENT_HOST_PATTERN=%

# Real integration tests are opt-in and use only the agent credentials above.
RUN_MYSQL_INTEGRATION=0
